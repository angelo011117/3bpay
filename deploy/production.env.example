# Copy to .env.production on the Ubuntu server; never commit the filled file.
POSTGRES_DB=threebpay
POSTGRES_USER=threebpay
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=0
ALLOWED_HOSTS=pay.3bsmartsolution.com,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://pay.3bsmartsolution.com
PUBLIC_BASE_URL=https://pay.3bsmartsolution.com
PUBLIC_PORTAL_WRITES_ENABLED=false
THREEBPAY_PROXY_PORT=18080
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Outbound delivery is deliberately off for initial production migration.
# It preserves pending outbox rows and creates neither delivery attempts nor sends.
EMAIL_DELIVERY_MODE=disabled

# Graph is read-only when later enabled. Keep false for initial cutover.
MICROSOFT_GRAPH_ENABLED=false
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_MAILBOX=
MICROSOFT_GRAPH_MAIL_FOLDER=inbox
MICROSOFT_GRAPH_POLL_INTERVAL_SECONDS=300
MICROSOFT_GRAPH_INITIAL_LOOKBACK_DAYS=7
MICROSOFT_GRAPH_SENDER=
MICROSOFT_GRAPH_TEST_RECIPIENTS=

VERCEL_ENABLED=false
VERCEL_MODE=simulation
VERCEL_TOKEN=
VERCEL_TEAM_ID=
